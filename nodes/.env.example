# Shared node configuration — copy to nodes/.env (setup.sh generates one with
# random secrets). Every node reads nodes/.env from its working directory;
# real environment variables override it. Never commit nodes/.env.

# Shared secret for node-to-node gRPC (≥ 16 chars, identical on every node)
CLUSTER_SECRET=replace-with-a-long-random-string

# Django API credentials for each node. A node uses NODE_PASS if set, otherwise
# the entry matching its NODE_NAME. `manage.py create_node_users` reads the same
# values, so Django and the nodes always agree.
NODE1_PASS=replace-me
NODE2_PASS=replace-me
NODE3_PASS=replace-me

DJANGO_URL=http://127.0.0.1:8000/api
ORACLE_URL=127.0.0.1:8001
VALIDATOR_ADDRESSES=localhost:9002,localhost:9003

# Per-node settings are passed on the command line, e.g.
#   NODE_NAME=node1 IS_LEADER=true ./nodes_bin
#   NODE_NAME=node2 ./nodes_bin      (listens on 9002)
#   NODE_NAME=node3 ./nodes_bin      (listens on 9003)
