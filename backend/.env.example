# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Oracle gRPC address (must match the port oracle_server.py listens on)
ORACLE_URL=127.0.0.1:8001

# Gemini API key — get a free key at https://aistudio.google.com/app/apikey
# Leave empty to disable the AI news feature (it will show a notice instead)
GEMINI_API_KEY=
