# Copy to .env (setup.sh does this and generates a random SECRET_KEY).
# Never commit .env to version control.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# The nodes' RPC, tried in order (the gateway only reads and forwards)
NODE_RPC=http://127.0.0.1:26657,http://127.0.0.1:26667,http://127.0.0.1:26677,http://127.0.0.1:26687

# One oracle signer, used only for display prices before the chain has one
ORACLE_DISPLAY_URL=127.0.0.1:8001

# Gemini (AI news and chat) — free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
